# NestJS API base URL (see Game-center-backend's PORT)
VITE_API_URL=http://localhost:4000/api

# Hosted HTML5 games portal — only needed if it differs from the backend's GAMES_BASE_URL
VITE_GAMES_BASE_URL=http://localhost:8642

# telebirr SuperApp mini-app id (for the in-SuperApp auth/payment bridge); leave unset
# to always fall back to phone+OTP login and the web checkout outside the SuperApp
VITE_TELEBIRR_MINIAPP_ID=
